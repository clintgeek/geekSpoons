# Hammerspoon Workstation Controller - Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is loaded by init.lua at startup.

# Calendar ICS feed URL (Outlook/Office365: Settings > Calendar > Publish a calendar)
CALENDAR_ICS_URL=https://outlook.office365.com/owa/calendar/YOUR_CALENDAR_ID/calendar.ics

# Weather location (city, state for wttr.in)
WEATHER_LOCATION=Arkadelphia, AR

# Optional: Override app paths if not in default locations
# MESSAGES_APP_PATH=/Users/YOU/Applications/Chrome Apps.localized/Messages.app
# CHATGPT_APP_PATH=/Users/YOU/Applications/Edge Apps.localized/ChatGPT.app

# Optional: Override Outlook OSA log path (only if non-standard Office install)
# OUTLOOK_OSA_PATH=/Users/YOU/Library/Group Containers/UBF8T346G9.Office/Outlook/Outlook 15 Profiles/Main Identity/Osa
